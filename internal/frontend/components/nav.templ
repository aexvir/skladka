package components

import (
	"github.com/aexvir/skladka/internal/auth"
	"github.com/aexvir/skladka/internal/frontend/icons"
)

type Link struct {
	Icon templ.Component
	Text string
	URL  templ.SafeURL
}

templ Nav(name string, user *auth.User, links ...Link) {
	<nav class="bg-surface-muted text-content px-4 py-2 flex justify-between items-center lowercase block border-b border-content-muted/30 ">
		<a class="flex flex-row items-center gap-4 transition-all text-content hover:text-accent" href="/">
			<img src="/static/landfill.svg" class="h-auto w-8" id="nav-logo"/>
			<div class="text-2xl">{ name }</div>
		</a>
		<div class="flex items-center gap-x-6">
			for _, link := range links {
				<a href={ link.URL } class="hover:text-accent text-content transition-colors flex items-center gap-2">
					if link.Icon != nil {
						@link.Icon
					}
					{ link.Text }
				</a>
			}
			if user == nil {
				<a href="/u/login" class="hover:text-accent text-content transition-colors flex items-center gap-2">
					@icons.User(16, 16, "text-content-muted")
					login
				</a>
			}
			if user != nil {
				<a
					href="/u/profile"
					class="hover:text-accent text-content transition-colors"
				>
					<span class="text-content-muted">&#64;</span>{ user.Username }
				</a>
			}
		</div>
	</nav>
}
