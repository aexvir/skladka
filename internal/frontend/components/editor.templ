package components

templ Editor(content, syntax string, readonly bool) {
	<div class="h-full w-full flex-1 min-w-0 min-h-0">
		<div id="editor" class="editor">
			<div class="editor-sticky" aria-hidden="true">
				<div class="editor-sticky-gutter"></div>
				<div class="editor-sticky-code"></div>
			</div>
			<div class="editor-gutter" aria-hidden="true"></div>
			<div class="editor-highlight" aria-hidden="true"></div>
			<textarea
				class="editor-input"
				rows="1"
				cols="1"
				spellcheck="false"
				autocomplete="off"
				autocapitalize="off"
				placeholder={ placeholder }
				readonly?={ readonly }
			></textarea>
		</div>
	</div>
	<style>
        .editor {
            --editor-padding: 1rem;
            color-scheme: light dark;
            position: relative;
            display: grid;
            grid-template-columns: auto 1fr;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: light-dark(#fcfcfc, #0d1016);
            font-family: "JetBrains Mono", monospace;
            font-weight: 500;
            font-size: 14px;
            line-height: 1.5;
            tab-size: 4;
        }

        .editor-sticky {
            grid-row: 1;
            grid-column: 1 / -1;
            align-self: start;
            position: sticky;
            top: 0;
            z-index: 2;
            display: grid;
            grid-template-columns: subgrid;
            cursor: pointer;
            background-color: inherit;
            box-shadow: 0 4px 6px -4px light-dark(#00000026, #00000080);
        }

        .editor-sticky-gutter {
            position: sticky;
            left: 0;
            padding: 0 1rem 0 1.5rem;
            text-align: right;
            white-space: pre;
            background-color: inherit;
            color: light-dark(#8a919966, #6c738099);
        }

        .editor-sticky-code {
            padding: 0 var(--editor-padding);
            white-space: pre;
        }

        .editor-sticky-code pre,
        .editor-sticky-code code,
        .editor-highlight pre,
        .editor-highlight code {
            margin: 0;
            padding: 0;
            font: inherit;
            background-color: transparent !important;
        }

        .editor-gutter {
            grid-row: 1;
            grid-column: 1;
            position: sticky;
            left: 0;
            z-index: 1;
            padding: var(--editor-padding) 1rem var(--editor-padding) 1.5rem;
            text-align: right;
            white-space: pre;
            user-select: none;
            background-color: inherit;
            color: light-dark(#8a919966, #6c738099);
        }

        .editor-highlight,
        .editor-input {
            grid-row: 1;
            grid-column: 2;
            margin: 0;
            padding: var(--editor-padding);
            border: 0;
            font: inherit;
            letter-spacing: inherit;
            white-space: pre;
            overflow-wrap: normal;
            tab-size: inherit;
        }

        .editor-input {
            align-self: stretch;
            justify-self: stretch;
            min-width: 100%;
            resize: none;
            overflow: hidden;
            outline: none;
            background: transparent;
            color: transparent;
            caret-color: light-dark(#ffaa33, #e6b450);
        }

        .editor-input::placeholder {
            color: light-dark(#8a919999, #6c7380cc);
        }

        .editor-input::selection {
            background-color: light-dark(#035bd626, #3388ff40);
        }
    </style>
	<script type="module">
        import { codeToHtml, isSupportedLanguage } from '/static/highlights/default.js'
        import ayuLight from '/static/highlights/themes/ayu-light.js'
        import ayuDark from '/static/highlights/themes/ayu-dark.js'

        const extensions = {
            go: 'go',
            python: 'py',
            yaml: 'yaml',
            hcl: 'hcl',
            ocaml: 'ml',
            json: 'json',
            xml: 'xml',
            rust: 'rs',
            zig: 'zig',
        }

        const container = document.getElementById('editor')
        const gutter = container.querySelector('.editor-gutter')
        const highlight = container.querySelector('.editor-highlight')
        const input = container.querySelector('.editor-input')
        const sticky = container.querySelector('.editor-sticky')
        const decoder = new TextDecoder()

        let syntax = 'plaintext'
        let lines = []
        let headers = []

        const highlighted = (text) => decoder.decode(
            codeToHtml(
                text,
                {
                    lang: syntax,
                    themes: { light: ayuLight, dark: ayuDark },
                    defaultColor: 'light-dark()',
                }
            )
        )

        // indentation of a line, or -1 for blank lines
        const indentation = (line) => lines[line].search(/\S/)

        // lines that open the indentation scopes containing the given line, outermost first
        const scopes = (line) => {
            const found = []
            while (line < lines.length - 1 && indentation(line) < 0) {
                line++
            }
            let indent = indentation(line)
            for (let i = line - 1; i >= 0 && indent > 0; i--) {
                const current = indentation(i)
                if (current >= 0 && current < indent) {
                    found.unshift(i)
                    indent = current
                }
            }
            return found.slice(-5)
        }

        // pin the lines opening the scopes of the topmost visible line, like monaco's sticky scroll
        const stick = () => {
            const { lineHeight, paddingTop } = getComputedStyle(input)
            const top = Math.max(
                0,
                Math.min(
                    Math.floor((container.scrollTop - parseFloat(paddingTop)) / parseFloat(lineHeight)),
                    lines.length - 1
                )
            )

            // the pinned lines cover the first visible ones, so look again from below them
            const below = top + scopes(top).length
            headers = scopes(below).filter((i) => i < below)

            sticky.style.display = headers.length ? '' : 'none'
            sticky.firstElementChild.textContent = headers.map((i) => i + 1).join('\n')
            sticky.lastElementChild.innerHTML = highlighted(headers.map((i) => lines[i]).join('\n'))
        }

        const render = () => {
            const text = input.value
            lines = text.split('\n')

            // a trailing newline needs a character after it to take up a line in the <pre>
            highlight.innerHTML = highlighted(text.endsWith('\n') ? `${text} ` : text)
            gutter.textContent = lines.map((_, i) => i + 1).join('\n')
            stick()
        }

        input.addEventListener('input', render)
        container.addEventListener('scroll', stick)

        sticky.addEventListener(
            'click',
            (e) => {
                const { lineHeight, paddingTop } = getComputedStyle(input)
                const index = Math.floor((e.clientY - sticky.getBoundingClientRect().top) / parseFloat(lineHeight))
                container.scrollTop = parseFloat(paddingTop) + headers[index] * parseFloat(lineHeight)
            }
        )

        input.addEventListener(
            'keydown',
            (e) => {
                if (e.key !== 'Tab' || input.readOnly || e.ctrlKey || e.metaKey || e.altKey) {
                    return
                }

                // insert a tab instead of moving focus; execCommand keeps the undo history
                e.preventDefault()
                document.execCommand('insertText', false, '\t')
            }
        )

        // export Editor object globally, so other components can interact with it
        window.Editor = {
            getContent: function() {
                return input.value
            },
            setContent: function(text) {
                input.value = text
                render()
            },
            setSyntax: function(lang) {
                syntax = isSupportedLanguage(lang) ? lang : 'plaintext'
                render()
            },
            setReadOnly: function() {
                input.readOnly = true
            },
            copyToClipboard: function() {
                window.Toaster.show(
                    'content copied to clipboard!', {
                        type: 'success',
                        duration: 3000
                    }
                )

                return navigator.clipboard.writeText(input.value)
            },
            downloadAsFile: function() {
                const blob = new Blob([input.value], { type: 'text/plain' })
                const url = URL.createObjectURL(blob)

                const title = document.
                    getElementById("paste-title").
                    innerText.
                    toLowerCase().
                    replace(/ /g, '-')

                const extension = extensions[syntax] ?? 'txt'

                const link = document.createElement('a')
                link.href = url
                link.download = `${title}.${extension}`
                link.click()

                URL.revokeObjectURL(url)
            }
        }

        render()
    </script>
	@editor(content, syntax, readonly)
}

const placeholder = `skladka(1)                    General Commands Manual                   skladka(1)

NAME
    skladka - a highly opinionated and minimalistic pastebin

WEB USAGE
    Drag a file and drop it here, or
    Paste an image from your clipboard using Ctrl + v, or
    After typing, press the big yellow button to paste, or
    Just press Ctrl + Enter once done typing.

MOBILE USAGE
    All of the above, or
    Use the upload button.

ROUTES
    GET /<id>
        Get raw pastes
    GET /p/<id>
        Get highlighted pastes
    GET /p/<id>.<ext>
        Get syntax highlighted pastes.

SEE ALSO
    github.com/aexvir/skladka`

script editor(content, syntax string, readonly bool) {
    const waitForEditor = new Promise(
        (resolve, reject) => {
            const start = Date.now()
            const timeout = 30000

            const check = () => {
                if (typeof window["Editor"] !== 'undefined') {
                    resolve(window.Editor)
                    return
                }

                if (Date.now() - start > timeout) {
                    reject(new Error("timeout waiting for editor"))
                    return
                }

                setTimeout(check, 10)
            }

            check()
        }
    )

    waitForEditor.then(
        (editor) => {
            editor.setContent(content)
            editor.setSyntax(syntax)
            if (readonly) {
                editor.setReadOnly()
            }
        }
    )
}
