package views

import "github.com/aexvir/skladka/internal/frontend/icons"

templ Login() {
	<div class="h-full w-full flex flex-row items-center justify-center bg-main">
		<div class="p-8 space-y-4 bg-muted border border-main rounded-lg shadow-xl">
			<h2 class="text-2xl font-bold inline-flex items-center gap-2">
				@icons.Hand(24, 24, "text-muted")
				hi there
			</h2>
			<div class="flex flex-col lg:flex-row w-full gap-2 lg:gap-0">
				<input
					type="text"
					id="username"
					name="username"
					placeholder="username"
					required
					class="h-10 p-2 flex-grow bg-muted text-main border border-main rounded lg:rounded-r-none focus:outline-none focus:border-accent"
				/>
				<button
					type="button"
					onclick="login()"
					class="h-10 px-4 py-2 rounded lg:rounded-l-none bg-accent text-accent-muted hover:bg-accent-muted transition-all duration-200"
				>
					login
				</button>
			</div>
		</div>
	</div>
	<script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
	<script>
		const { startRegistration, startAuthentication } = SimpleWebAuthnBrowser

		async function registered(username) {
			const response = await fetch(
				'/u/login/exists',
				{
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({ username }),
				}
			)

			switch (response.status) {
				case 200:
					return true
				case 404:
					return false
				default:
					return false
			}
		}

		async function login() {
			const username = document.getElementById('username').value

			if (!username) {
				window.Toaster.show(
					"username can't be empty", {
						type: 'error',
						duration: 3000
					}
				)
				return
			}

			let action = 'login'
			let operation = startAuthentication

			const userHasAccount = await registered(username)
			if (!userHasAccount) {
				action = 'register'
				operation = startRegistration
			}

			const response = await fetch(
				`/u/${action}/start`,
				{
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({ username }),
				}
			)

			if(!response.ok) {
				alert('oops')
				return
			}

			const options = await response.json()
			const payload = await operation({ optionsJSON: options.publicKey })
				.catch(
					error => {
						window.Toaster.show(
							`error during ${action}`, {
								type: 'error',
								duration: 3000
							}
						)
					}
				)

			const verification = await fetch(
				`/u/${action}/finish`,
				{
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify(payload),
				}
			)

			if (!verification.ok) {
				window.Toaster.show(
					`error during ${action}`, {
						type: 'error',
						duration: 3000
					}
				)
				return
			}

			window.location.assign("/")

			window.Toaster.show(
				`${action} successful; welcome ${username}`, {
					type: 'success',
					duration: 3000
				}
			)
		}
	</script>
}
