package views

import (
	"github.com/aexvir/skladka/internal/auth"
	"github.com/aexvir/skladka/internal/frontend/icons"
	"time"
)

templ Profile(user auth.User, viewer *auth.User) {
	<div class="container mx-auto px-4 py-8 flex flex-col md:flex-row gap-4 items-stretch md:items-start">
		<div class="w-full md:w-1/5 bg-muted rounded-lg border border-main p-4 flex flex-row md:flex-col gap-4">
			<img src={ user.Avatar } class="w-1/3 md:w-full aspect-square rounded-lg object-cover"/>
			<div class="flex flex-col w-full">
				<div class="space-y-2 flex-1 md:pb-4">
					<h1 class="text-2xl font-bold text-blue-400">&#64;{ user.Username }</h1>
					<div class="text-sm text-muted-foreground">
						<div class="flex items-center gap-2">
							@icons.Calendar(16, 16, "text-muted")
							<span>joined { time.Now().Format("Jan 2, 2006") }</span>
						</div>
					</div>
				</div>
				if viewer != nil && user.Username == viewer.Username {
					<a
						href="/u/logout"
						class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded bg-accent text-accent-muted hover:bg-accent-muted transition-all duration-200"
					>
						@icons.LogOut(16, 16, "")
						<span>logout</span>
					</a>
				}
			</div>
		</div>
		<div class="flex-1 space-y-4">
			<div class="bg-muted rounded-lg border border-main p-4 w-full">
				<div class="flex flex-col md:flex-row items-center w-full gap-2">
					<div class="flex-1 relative w-full">
						<input
							type="text"
							placeholder="find a paste..."
							id="paste-search-input"
							class="w-full px-4 py-2 bg-main border border-main rounded focus:outline-none focus:border-accent"
						/>
						<div class="absolute right-3 top-1/2 -translate-y-1/2">
							@icons.Search(16, 16, "text-muted")
						</div>
					</div>
					<div class="w-full md:w-auto flex flex-row gap-2 items-stretch md:items-center">
						<select id="paste-visibility-select" class="bg-main border border-main rounded px-4 py-2 w-full md:w-auto">
							<option>all</option>
							<option>public</option>
							<option>unlisted</option>
						</select>
						<select id="paste-sort-select" class="bg-main border border-main rounded px-4 py-2 w-full md:w-auto">
							<option>most recent</option>
							<option>oldest</option>
						</select>
					</div>
					<a class="px-4 py-2 rounded bg-accent text-accent-muted hover:bg-accent-muted transition-all duration-200 order-first md:order-last w-full md:w-auto" href="/">
						new paste
					</a>
				</div>
				<div
					id="pastes-container"
					class="space-y-4 mt-4"
					hx-get={ "/archive?username=" + user.Username }
					hx-target="this"
					hx-select="#pastes"
					hx-trigger="load"
					hx-indicator="#paste-loading"
					hx-on::after-swap="filterAndSortPastes()"
				>
					<div id="paste-loading" class="htmx-indicator flex items-center justify-center py-8">
						<div class="animate-spin rounded-full h-8 w-8 border-2 border-accent"></div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script>
		function filterAndSortPastes() {
			console.log("filtering and sorting")
			var filters = {
				name: document.getElementById('paste-search-input').value.toLowerCase(),
				visibility: document.getElementById('paste-visibility-select').value.toLowerCase(),
				order: document.getElementById('paste-sort-select').value.toLowerCase(),
			}

			var container = document.getElementById('pastes-container')
			var entries = Array.from(container.querySelectorAll('a[data-created-at]'))

			entries.forEach(
				function(entry) {
					const text = entry.innerText.toLowerCase()
					const pasteNameMatches = text.includes(filters.name)

					const pasteIsUnlisted = entry.getAttribute('data-unlisted') === 'true'
					const pasteVisibilityMatches = (
						filters.visibility === 'all' ||
						( pasteIsUnlisted ? filters.visibility === 'unlisted' : filters.visibility === 'public' )
					)

					entry.style.display = (pasteNameMatches && pasteVisibilityMatches) ? '' : 'none'
				}
			)

			entries.sort(
				function(left, right) {
					var ldate = new Date(left.getAttribute('data-created-at'))
					var rdate = new Date(right.getAttribute('data-created-at'))
					if (filters.order === 'most recent') {
						return rdate - ldate
					}
					return ldate - rdate
				}
			)

			for (const [index, entry] of entries.entries()) {
				entry.style.order = index
			}
		}

		document.getElementById('paste-search-input').addEventListener('input', filterAndSortPastes)
		document.getElementById('paste-visibility-select').addEventListener('change', filterAndSortPastes)
		document.getElementById('paste-sort-select').addEventListener('change', filterAndSortPastes)
	</script>
}
